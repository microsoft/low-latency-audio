#include <winres.h>
#include "resource.h"

// The build script passes the version in through the project's LlaVersion* properties. These
// defaults are what a plain Visual Studio build gets.
#ifndef LLA_VERSION_MAJOR
#define LLA_VERSION_MAJOR 1
#endif
#ifndef LLA_VERSION_MINOR
#define LLA_VERSION_MINOR 0
#endif
#ifndef LLA_VERSION_BUILD
#define LLA_VERSION_BUILD 0
#endif
#ifndef LLA_VERSION_REVISION
#define LLA_VERSION_REVISION 0
#endif

#define LLA_STRINGIZE_INNER(value) #value
#define LLA_STRINGIZE(value) LLA_STRINGIZE_INNER(value)

#define LLA_VERSION_TEXT \
    LLA_STRINGIZE(LLA_VERSION_MAJOR) "." \
    LLA_STRINGIZE(LLA_VERSION_MINOR) "." \
    LLA_STRINGIZE(LLA_VERSION_BUILD) "." \
    LLA_STRINGIZE(LLA_VERSION_REVISION)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APPICON ICON "Assets\\AppIcon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LLA_VERSION_MAJOR,LLA_VERSION_MINOR,LLA_VERSION_BUILD,LLA_VERSION_REVISION
 PRODUCTVERSION LLA_VERSION_MAJOR,LLA_VERSION_MINOR,LLA_VERSION_BUILD,LLA_VERSION_REVISION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Microsoft Corporation"
            VALUE "FileDescription", "Low-Latency Audio Driver Selector"
            VALUE "FileVersion", LLA_VERSION_TEXT
            VALUE "InternalName", "LowLatencyDriverSelector"
            VALUE "LegalCopyright", "Copyright (c) Microsoft Corporation. Licensed under the MIT License."
            VALUE "OriginalFilename", "LowLatencyDriverSelector.exe"
            VALUE "ProductName", "Microsoft Low-Latency Audio"
            VALUE "ProductVersion", LLA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
