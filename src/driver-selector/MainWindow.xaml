<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LowLatencyDriverSelector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LowLatencyDriverSelector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- Spans every column so it sits in the middle of the window. Not hit testable, so it
                 stays part of the drag region. Hidden when this is not a preview build. -->
            <Grid x:Name="PreviewChiclet"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Height="18"
                  IsHitTestVisible="False">
                <!-- A shape, not a Border: a Border snaps its corner radius to whole pixels along
                     with its bounds, so at 125% scaling the arc comes out stepped. -->
                <Rectangle RadiusX="9"
                           RadiusY="9"
                           StrokeThickness="1"
                           UseLayoutRounding="False"
                           Stroke="{ThemeResource SystemFillColorCautionBrush}"
                           Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <TextBlock x:Name="PreviewChicletText"
                           x:Uid="PreviewChicletText"
                           Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="9,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Grid>
        </Grid>

        <!-- ================================== Content ================================== -->
        <Grid Grid.Row="1" Margin="16,8,16,16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Uid="PageTitle"
                               Text="USB Audio 2.0 devices"
                               AutomationProperties.HeadingLevel="Level1"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="PageDescription"
                               Text="Choose the driver each USB Audio 2.0 device uses."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button x:Name="RefreshButton"
                        x:Uid="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        VerticalAlignment="Top"
                        Click="OnRefreshClick" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar x:Name="ElevationBar"
                         x:Uid="ElevationBar"
                         Severity="Warning"
                         IsClosable="False"
                         IsOpen="False"
                         Title="Running without administrator rights"
                         Message="Changing a driver needs administrator rights.">
                    <InfoBar.ActionButton>
                        <Button x:Name="RestartElevatedButton"
                                x:Uid="RestartElevatedButton"
                                Content="Restart as administrator"
                                Click="OnRestartElevatedClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="PackageMissingBar"
                         x:Uid="PackageMissingBar"
                         Severity="Warning"
                         IsClosable="False"
                         IsOpen="False"
                         Title="The low-latency driver isn't installed"
                         Message="Run the installer again to add it." />

                <!-- the outcome of the last driver change, which the next refresh must not overwrite -->
                <InfoBar x:Name="FollowUpBar" IsOpen="False" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />

                <ProgressRing x:Name="StatusProgressRing"
                              Grid.Column="1"
                              Width="20"
                              Height="20"
                              IsActive="False"
                              VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Uid="CautionText"
                       Grid.Row="3"
                       Text="Close any apps that are using a device before you change its driver."
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <ListView x:Name="DevicesListView"
                      x:Uid="DevicesListView"
                      Grid.Row="4"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,2,0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AudioDeviceItem">
                        <Grid Margin="0,0,0,4" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                            <!-- a shape rather than a Border with rounded corners, for the same
                                 reason as the PREVIEW badge -->
                            <Rectangle RadiusX="8"
                                       RadiusY="8"
                                       StrokeThickness="1"
                                       UseLayoutRounding="False"
                                       Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                       Stroke="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid Padding="14,12,14,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DriverText, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind NoteText, Mode=OneWay}"
                                               Visibility="{x:Bind NoteVisibility, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind DetailText, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ProblemText, Mode=OneWay}"
                                               Visibility="{x:Bind ProblemVisibility, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Uid="UseLowLatencyButton"
                                            Content="Use low-latency driver"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind CanUseLowLatency, Mode=OneWay}"
                                            Click="OnUseLowLatencyClick" />
                                    <Button x:Uid="UseWindowsButton"
                                            Content="Use Windows driver"
                                            IsEnabled="{x:Bind CanUseWindows, Mode=OneWay}"
                                            Click="OnUseWindowsClick" />
                                    <Button x:Uid="UseManufacturerButton"
                                            Content="Use manufacturer's driver"
                                            IsEnabled="{x:Bind CanUseManufacturer, Mode=OneWay}"
                                            Click="OnUseManufacturerClick" />
                                    <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Width="20"
                                                  Height="20" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ================================== Dialogs ================================== -->
        <ContentDialog x:Name="ConfirmDialog"
                       x:Uid="ConfirmDialog"
                       PrimaryButtonText="Change driver"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <ScrollViewer MaxHeight="360">
                <TextBlock x:Name="ConfirmDialogText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="RestartComputerDialog"
                       x:Uid="RestartComputerDialog"
                       Title="Restart Windows now?"
                       PrimaryButtonText="Restart now"
                       CloseButtonText="Later"
                       DefaultButton="Close">
            <TextBlock x:Name="RestartComputerDialogText" TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog x:Name="ReplugDeviceDialog"
                       x:Uid="ReplugDeviceDialog"
                       Title="Reconnect the device"
                       CloseButtonText="OK"
                       DefaultButton="Close">
            <TextBlock x:Name="ReplugDeviceDialogText" TextWrapping="Wrap" />
        </ContentDialog>
    </Grid>
</Window>
